DOMAIN=notifications.example.com
IMAGE_TAG=latest

# Supabase Session Pooler connection string. Keep the URL private.
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-with-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=8h

# The browser origin allowed by the API and WebSocket handshake.
CORS_ORIGIN=https://notifications.example.com

# Required for the initial production seed only.
ADMIN_INITIAL_PASSWORD=replace-before-first-seed

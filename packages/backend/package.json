{
  "name": "@notification-sharing/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend — Node.js + Express + TypeScript + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
    "test:watch": "node node_modules/jest/bin/jest.js --watch --runInBand",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.6"
  }
}
